@model List<TaskItem>
@{
    ViewData["Title"] = "Your Tasks";
}
<div class="login-page">
    <div class="bg-overlay"></div>
    <div class="login-card" style="max-width: 800px;">
        <h2>Your Tasks</h2>
        <p class="subtitle">Manage your task list</p>

        <div class="field" style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; margin-bottom: 20px;">
                <thead>
                    <tr style="border-bottom: 2px solid rgba(0,0,0,0.1);">
                        <th style="padding: 12px 10px;color: #ffffff;">Name</th>
                        <th style="padding: 12px 10px;color: #ffffff;">Description</th>
                        <th style="padding: 12px 10px;color: #ffffff;">Status</th>
                        <th style="padding: 12px 10px; text-align: center; color: #ffffff;">Actions</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                            <td style="padding: 12px 10px; font-weight: 500;color: #ffffff;">@task.Name</td>
                            <td style="padding: 12px 10px; font-size: 0.9em; color: #ffffff;">@task.Description</td>
                            <td style="padding: 12px 10px;">
                                <form asp-action="Index" asp-controller="TaskItems" method="post" style="margin: 0;">
                                    <input type="hidden" name="id" value="@task.Id" />
                                    <select name="status" onchange="this.form.submit()" style="padding: 6px; border-radius: 4px; border: 1px solid #ccc; font-family: inherit; font-size: 0.9em;">
                                        <!option value="Pending" @(task.Status == "Pending" ? "selected" : "")>Pending</!option>
                                        <!option value="In Progress" @(task.Status == "In Progress" ? "selected" : "")>In Progress</!option>
                                        <!option value="Completed" @(task.Status == "Completed" ? "selected" : "")>Completed</!option>
                                    </select>
                                </form>
                            </td>
                            <td style="padding: 12px 10px;">
                                <div style="display: flex; gap: 8px; justify-content: center;">
                                    <a href="/Tasks/Edit/@task.Id" class="btn" style="padding: 6px 12px; font-size: 0.8em; margin: 0; min-width: auto; line-height: 1.5; text-decoration: none;">Edit</a>
                                    
                                    <form asp-action="Delete" asp-controller="TaskItems" method="post" style="margin: 0;">
                                        <input type="hidden" name="Id" value="@task.Id" />
                                        <button type="submit" class="btn" style="padding: 6px 12px; font-size: 0.8em; margin: 0; min-width: auto; background-color: #dc3545; border-color: #dc3545; line-height: 1.5;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <form method="post" action="/TaskItems/Create" style="margin-top: 20px;">
            <button type="submit" class="btn">Add New Task</button>
        </form>
    </div>
</div>