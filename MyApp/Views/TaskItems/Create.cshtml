@model MyApp.Models.TaskItem
@{
    ViewData["Title"] = "Create";
}
<div class="login-page">
    <div class="bg-overlay"></div>
    <div class="login-card">
        <h2>Create a Task</h2>
        <p class="subtitle">Enter the new task details</p>
        
        <form asp-action="Create" method="post">
            <div class="field">
                <label for="Name">Name</label>
                <input type="text" asp-for="Name" placeholder="Task Name" required />
            </div>
            <div class="field">
                <label for="Description">Description</label>
                <input type="text" asp-for="Description" placeholder="Task Description" required />
            </div>
            
            <button type="submit" class="btn">Submit</button>
            <p class="footer"><a href="/TaskItems/Index">Cancel</a></p>
        </form>
    </div>
</div>