@model MyApp.Models.TaskItem
@{
    ViewData["Title"] = "Delete";
}
<div class="login-page">
    <div class="bg-overlay"></div>
    <div class="login-card">
        <h2>Delete Task</h2>
        <p class="subtitle">Are you sure you want to delete this Task</p>
        
        <div class="field" style="text-align: center; margin-bottom: 20px;">
            <p><strong>@Model.Name</strong></p>
        </div>

        <form asp-controller="TaskItems" asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn">Delete</button>
            <p class="footer"><a href="/TaskItems/Index">Cancel</a></p>
        </form>
    </div>
</div>