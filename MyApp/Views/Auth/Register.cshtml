<div class="login-page">
    <div class="bg-overlay"></div>

    <div class="login-card">
        <h2>Create account</h2>
        <p class="subtitle">Join us today</p>

        @if (ViewBag.Error != null)
        {
            <div class="error-box">
                <span class="error-icon">!</span>
                @ViewBag.Error
            </div>
        }

        <form method="post" id="register-form">
            <div class="field">
                <label>Email</label>
                <input name="email" type="email" placeholder="you@example.com" required />
            </div>

            <div class="field">
                <label>Password</label>
                <input name="password" type="password" id="password" placeholder="••••••••" required />

                <ul class="rules" id="rules">
                    <li id="rule-length">  Minimum 8 characters</li>
                    <li id="rule-upper">   One uppercase letter</li>
                    <li id="rule-lower">   One lowercase letter</li>
                    <li id="rule-number">  One number</li>
                    <li id="rule-special"> One special character</li>
                </ul>
            </div>

            <button type="submit" class="btn" id="submit-btn" disabled>Create account</button>
        </form>

        <p class="footer">Already have an account? <a href="/Auth/Login">Sign in here</a></p>
    </div>
</div>

<script>
    const password = document.getElementById('password');
    const submitBtn = document.getElementById('submit-btn');

    const rules = {
      'rule-length':  v => v.length >= 8,
      'rule-upper':   v => /[A-Z]/.test(v),
      'rule-lower':   v => /[a-z]/.test(v),
      'rule-number':  v => /[0-9]/.test(v),
      'rule-special': v => /[^A-Za-z0-9]/.test(v),
    };

    password.addEventListener('input', () => {
      const val = password.value;
      let allPassed = true;

      for (const [id, test] of Object.entries(rules)) {
        const el = document.getElementById(id);
        const passed = test(val);
        el.classList.toggle('passed', passed);
        el.classList.toggle('failed', val.length > 0 && !passed);
        if (!passed) allPassed = false;
      }

      submitBtn.disabled = !allPassed;
    });
</script>